# Port only, URLs are not accepted
ETH_LOCAL_RPC_PORT=8545
# Native Linux Docker needs 0.0.0.0 (or the docker0 gateway IP) so containers reach the node
ETH_LOCAL_RPC_BIND_IP=127.0.0.1

GITHUB_ORG=lidofinance

# Defaults live in src/common/env.ts and are what CI tests; override only to try another revision
#GIT_BRANCH_SCRIPTS=master
#GIT_BRANCH_CORE=master
#GIT_BRANCH_DG=develop
#GIT_BRANCH_STAKING_MODULES=develop
#GIT_BRANCH_STONKS=main

# Full 40-char commit SHA, checked out instead of the branch head; GIT_SHA_DG defaults to a pinned commit
#GIT_SHA_SCRIPTS=
#GIT_SHA_CORE=
#GIT_SHA_DG=
#GIT_SHA_STAKING_MODULES=
#GIT_SHA_STONKS=

SCRIPTS_IMAGE=ghcr.io/lidofinance/scripts:v22
# core needs native solc (viaIR), the wasm one used on arm64 runs out of memory
#IMAGE_PLATFORM_CORE=linux/amd64
# staking-modules needs linux/amd64 on Apple Silicon: foundry's aarch64 solc list lacks the required version
#IMAGE_PLATFORM_STAKING_MODULES=linux/amd64

# could be more than one url - url1,url2,url3,...
ETH_MAINNET_RPC_URL=
ETH_HOODI_RPC_URL=
ETHERSCAN_TOKEN=

PINATA_JWT=