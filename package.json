{
  "name": "hardhat-project",
  "type": "module",
  "scripts": {
    "omnibus:create": "hardhat omnibus:create",
    "omnibus:contract": "hardhat omnibus:contract",
    "omnibus:build": "hardhat omnibus:build",
    "omnibus:run": "hardhat omnibus:run",
    "omnibus:test": "hardhat omnibus:test",
    "omnibus:simulate": "hardhat omnibus:simulate",
    "omnibus:debug": "hardhat omnibus:simulate _example_regular_omnibus",
    "omnibus:ci-prepare": "hardhat omnibus:ci-prepare _example_tiny_omnibus",
    "omnibus:multi-test": "hardhat omnibus:multi-test",
    "abi:sync": "hardhat abi:sync",
    "ks:add": "hardhat keystore:add",
    "ks:ls": "hardhat keystore:list",
    "ks:del": "hardhat keystore:delete",
    "ks:gen": "hardhat keystore:generate",
    "ks:pwd": "hardhat keystore:password",
    "rpc:stop": "hardhat rpc:stop",
    "example:test:mainnet": "hardhat omnibus:test _example_tiny_omnibus",
    "example:test:holesky": "hardhat omnibus:test _example_tiny_holesky_omnibus",
    "example:run:holesky": "hardhat omnibus:run _example_tiny_holesky_omnibus --rpc remote --test-account false --network holesky",
    "example:multi-test:mainnet": "hardhat omnibus:multi-test _example_tiny_omnibus",
    "example:multi-test:scripts:mainnet": "hardhat omnibus:multi-test _example_tiny_omnibus --mount-tests --repo scripts",
    "example:multi-test:dg:mainnet": "hardhat omnibus:multi-test _example_tiny_omnibus --mount-tests --repo dual-governance",
    "example:multi-test:core:mainnet:custom": "hardhat omnibus:multi-test _example_tiny_omnibus --mount-tests --repo core --pattern test/custom/_example_omnibus_test_for_core_repo.ts",
    "example:multi-test:scripts:mainnet:custom": "hardhat omnibus:multi-test _example_tiny_omnibus --mount-tests --repo scripts --pattern tests/custom/_example_omnibus_test_for_scripts_repo.py",
    "example:multi-test:dg:mainnet:custom": "hardhat omnibus:multi-test _example_tiny_omnibus --mount-tests --repo dual-governance --pattern test/custom/*",
    "example:multi-test:all:mainnet:custom": "hardhat omnibus:multi-test _example_tiny_omnibus --mount-tests --pattern default",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "style": "prettier --write .",
    "prettier:check": "prettier --check .",
    "fmt:sol": "forge fmt",
    "fmt:sol:check": "forge fmt --check",
    "prepare": "husky && node scripts/sync-skills.js",
    "sync-skills": "node scripts/sync-skills.js",
    "test": "nyc --reporter text-summary mocha",
    "test:integration": "mocha --config .mocharc.integration.json",
    "test:all": "npm test && npm run test:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/chai": "^4.3.14",
    "@types/chai-as-promised": "^7.1.8",
    "@types/clarinet": "^0.12.1",
    "@types/deep-eql": "^4.0.2",
    "@types/dockerode": "^3.3.32",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.7.5",
    "@types/prompts": "^2.4.4",
    "@types/sinon": "^17.0.3",
    "chai-as-promised": "^7.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "hardhat": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^10.2.0",
    "nock": "^13.5.0",
    "nyc": "^15.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^2.2.1",
    "sinon": "^17.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2",
    "viem": "^2.30.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "abitype": "^1.0.8",
    "chai": "^4.3.8",
    "chalk": "^4.1.2",
    "clarinet": "^0.12.6",
    "deep-eql": "4.1.4",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "ipfs-only-hash": "^4.0.0",
    "nanospinner": "^1.2.2",
    "pinata-web3": "^0.5.2",
    "prompts": "^2.4.2",
    "web3-eth-accounts": "^4.1.1",
    "web3-types": "^1.3.1"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "packageManager": "npm@10.9.2"
}
