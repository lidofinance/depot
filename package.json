{
  "name": "hardhat-project",
  "type": "module",
  "scripts": {
    "omnibus:create": "hardhat omnibus:create",
    "omnibus:build": "hardhat omnibus:build",
    "omnibus:test": "hardhat omnibus:test",
    "omnibus:multi-test": "hardhat omnibus:multi-test",
    "abi:sync": "hardhat abi:sync",
    "ks:add": "hardhat keystore:add",
    "ks:ls": "hardhat keystore:list",
    "ks:del": "hardhat keystore:delete",
    "ks:gen": "hardhat keystore:generate",
    "ks:pwd": "hardhat keystore:password",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "style": "prettier --write .",
    "prettier:check": "prettier --check .",
    "fmt:sol": "forge fmt",
    "fmt:sol:check": "forge fmt --check",
    "types": "tsc --noEmit",
    "prepare": "husky",
    "test": "npm run test:depot:unit --",
    "test:depot:unit": "nyc --reporter text-summary mocha",
    "test:depot:integration": "mocha --config .mocharc.integration.json",
    "test:sol": "forge test --match-path 'contracts/libraries/*.t.sol'",
    "test:all": "npm run test:depot:unit && npm run test:depot:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/chai": "^4.3.14",
    "@types/chai-as-promised": "^7.1.8",
    "@types/clarinet": "^0.12.1",
    "@types/deep-eql": "^4.0.2",
    "@types/dockerode": "^3.3.32",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.7.5",
    "@types/prompts": "^2.4.4",
    "@types/sinon": "^17.0.3",
    "chai-as-promised": "^7.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "hardhat": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.2.5",
    "sinon": "^17.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2",
    "viem": "^2.30.6"
  },
  "dependencies": {
    "abitype": "^1.0.8",
    "chai": "^4.3.8",
    "chalk": "^4.1.2",
    "clarinet": "^0.12.6",
    "deep-eql": "4.1.4",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "ipfs-only-hash": "^4.0.0",
    "nanospinner": "^1.2.2",
    "pinata-web3": "^0.5.2",
    "prompts": "^2.4.2",
    "web3-eth-accounts": "^4.1.1",
    "web3-types": "^1.3.1"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "packageManager": "npm@10.9.2"
}
